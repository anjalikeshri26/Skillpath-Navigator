# Copy to .env and fill in. Never commit the real file.
ENVIRONMENT=development
# Required in production (32+ characters). In development a temporary key is generated if empty.
SECRET_KEY=
DATABASE_URL=sqlite:///./skillpath.db

# AI features (interviews, tutor, question generation) use Groq. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Check https://console.groq.com/docs/models if a model ID stops working; Groq retires models periodically.
GROQ_FAST_MODEL=openai/gpt-oss-20b

SERVE_FRONTEND=true
SEED_DEMO_USER=true
